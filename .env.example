# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Neon) ---
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection, used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Secrets ---
# 32 random bytes, base64-encoded. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""
# Random string, at least 32 characters.
SESSION_SECRET=""

# --- Cron (production) ---
# Optional. When set, /api/cron/* requires `Authorization: Bearer <this>`.
# Vercel sends it automatically for scheduled jobs.
CRON_SECRET=""

# --- Local S3 (SeaweedFS) — only needed by the integration smoke test ---
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
# Bucket used ONLY by the integration tests. It must be a throwaway bucket:
# the suites create and delete objects in it, and one runs the orphan sweeper
# with no grace period. Point this at a bucket no real connection uses, or a
# test run will delete real uploads.
S3_BUCKET="s3-explorer-test"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
